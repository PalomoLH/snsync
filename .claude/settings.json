{
  "permissions": {
    "allow": [
      "Bash(node snsync --pull *)",
      "Bash(./snsync --pull *)",
      "Bash(now-sdk query *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(./projects/*/.env)",
      "Read(./projects/*/.env.*)",
      "Read(./projects/*/.token_cache.json)",
      "Read(./team-private/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/sn-guard.cjs\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
